#!/usr/bin/env bash
# Says, before a push to a release line, which changes the other line will still lack on the
# remote once the push lands. It never stops the push: one line may be pushed ahead of the other,
# and the Branch Sync workflow keeps reporting what is missing until the copy arrives.
# Install with scripts/git-hooks/install.sh.
set -euo pipefail

remote="$1"
root=$(git rev-parse --show-toplevel)
# shellcheck source=../branch-sync/lib.sh
source "$root/scripts/branch-sync/lib.sh"
branch_lines_load

# Each line as the remote will hold it after this push: the commit being pushed, or the
# remote-tracking ref of a line this push leaves alone.
mainline_ref="refs/remotes/$remote/$BL_MAINLINE"
maintenance_ref="refs/remotes/$remote/$BL_MAINTENANCE"
pushes_release_line=0
while read -r _ local_sha remote_ref _; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$remote_ref" == "refs/heads/$BL_MAINLINE" ]]; then
    mainline_ref="$local_sha"
    pushes_release_line=1
  elif [[ "$remote_ref" == "refs/heads/$BL_MAINTENANCE" ]]; then
    maintenance_ref="$local_sha"
    pushes_release_line=1
  fi
done
(( pushes_release_line )) || exit 0

if report=$(bash "$root/scripts/branch-sync/check.sh" --refs "$mainline_ref" "$maintenance_ref" 2>&1); then
  exit 0
fi
{
  echo "ℹ pre-push: after this push the release lines differ on $remote. The push goes ahead."
  echo "  Push both lines together (git push --atomic $remote $BL_MAINLINE $BL_MAINTENANCE), or carry what is listed:"
  echo "$report"
} >&2
exit 0
