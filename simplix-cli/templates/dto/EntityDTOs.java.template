<%
// Helper: Collect unique fields for @UniqueFields annotation
function getUniqueFieldsForCreate() {
    const uniqueFields = [];
    const createFields = getMergedFieldsForView('edit');
    for (let mergedField of createFields) {
        const field = mergedField;
        const ymlField = mergedField.ymlField;
        if (field.name === ymlConfig.idField) continue;
        if (ymlField?.unique) {
            // Determine the property name (same logic as field generation)
            // Use helper to avoid 'IdId' pattern when field already ends with 'Id'
            let propertyName = field.name;
            if (!mergedField.isInherited && ymlField?.reference) {
                propertyName = getReferenceIdFieldName(field.name, ymlField.reference.multiple);
            }
            uniqueFields.push({
                entityField: field.name,
                property: propertyName
            });
        }
    }
    return uniqueFields;
}

// Helper: Check if field is a String type
function isStringType(fieldType) {
    return fieldType === 'String' || fieldType === 'java.lang.String';
}

// Helper: Generate validation annotations for a field
function getValidationAnnotations(ymlField, fieldType, isCreateDto = true) {
    const annotations = [];

    // Required validation
    if (ymlField?.required) {
        if (isStringType(fieldType)) {
            annotations.push('@NotBlank');
        } else {
            annotations.push('@NotNull');
        }
    }

    // Length validation (for String fields)
    if (ymlField?.maxLength && isStringType(fieldType)) {
        annotations.push(`@Length(max = ${ymlField.maxLength})`);
    }

    // Min/Max validation (for numeric fields)
    if (ymlField?.min !== undefined) {
        annotations.push(`@Min(${ymlField.min})`);
    }
    if (ymlField?.max !== undefined) {
        annotations.push(`@Max(${ymlField.max})`);
    }

    // Pattern validation
    if (ymlField?.pattern) {
        annotations.push(`@Pattern(regexp = "${ymlField.pattern}")`);
    }

    return annotations;
}

const createUniqueFields = getUniqueFieldsForCreate();
const hasUniqueFields = createUniqueFields.length > 0;
// Only an entity that declares the soft-delete flag has one; naming it on any other entity makes
// the uniqueness check query an attribute that does not exist, and every create fails.
const hasSoftDelete = entityFields.some(f => f.name === 'deleted');
%>
