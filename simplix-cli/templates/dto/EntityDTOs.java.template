    @Data
    public static class <%= classPrefix %>BatchUpdateDTO {
        <% if (hasEmbeddedId) {
            const idFieldInfo = entitySearchFields.find(f => f.name === ymlConfig.idField); %>
        @Schema(description = "<%= idFieldInfo?.comment || `${entityName} ID` %> list")
        @FieldLabel("{entities.<%= entityName %>.<%= ymlConfig.idField %>}")
        private Set<<%= embeddedIdType %>> <%= ymlConfig.idField %>s;
        <% } else {
            const idFieldInfo = entitySearchFields.find(f => f.name === ymlConfig.idField); %>
        @Schema(description = "<%= idFieldInfo?.comment || `${entityName} ID` %> list")
        @FieldLabel("{entities.<%= entityName %>.<%= ymlConfig.idField %>}")
        private Set<<%= idFieldInfo?.type || idType %>> <%= ymlConfig.idField %>s;
        <% } %>
        <%
        const batchUpdateFields = getMergedFieldsForView('batchUpdate');
        for (let mergedField of batchUpdateFields) {
            const field = mergedField;
            const ymlField = mergedField.ymlField;
            if (field.name === ymlConfig.idField) continue;

            let fieldType = formatDtoFieldType(field, ymlField);
            let fieldName = field.name;
            let comment = ymlField?.comment || (field.comment ? field.comment.split(':')[0] : fieldNameToComment(field.name));

            // Skip reference/collection handling for inherited fields
            if (!mergedField.isInherited) {
                // For reference field
                if (ymlField?.reference) {
                    // Skip if entity already has explicit ID field (e.g., channelId for channel)
                    // The explicit ID field will be processed separately
                    if (!ymlField.reference.multiple && hasExplicitIdField(field.name)) {
                        continue; // Skip this reference field to avoid duplicate
                    }
                    const collectionType = ymlField.reference.multiple ? 'Set' : null;
                    fieldType = collectionType
                        ? `${collectionType}<${ymlField.reference.idType || 'String'}>`
                        : ymlField.reference.idType || 'String';
                    // Use helper to avoid 'IdId' pattern when field already ends with 'Id'
                    fieldName = getReferenceIdFieldName(field.name, ymlField.reference.multiple);
                    // Only append ' ID' to comment if field name doesn't already end with 'Id'
                    if (!holdsReferenceKey(field.name)) {
                        comment = `${comment} ID`;
                    }
                }
                // For collection field
                else if (field.isCollection) {
                    if (field.collectionType === 'Map') {
                        fieldType = field.type;  // Use original type format like Map<String, String>
                    } else {
                        fieldType = `${field.collectionType || 'List'}<${field.actualType || 'String'}>`;
                    }
                }
            }
        %>
        @Schema(description = "<%= comment %>")
        @FieldLabel("{entities.<%= entityName %>.<%= field.name %>}")
        private <%- fieldType %> <%= fieldName %>;
        <% } %>
    }

