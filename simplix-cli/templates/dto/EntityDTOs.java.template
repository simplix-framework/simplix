<%
// Parse import statements for reference entities
const importedTypes = new Set();

// Helper: Check if a type is a standard Java library type that should NOT be imported as an entity
function isStandardJavaType(typeName, importPath) {
    if (!typeName) return false;
    // Skip java.* types (they are already imported via wildcards)
    if (importPath && importPath.startsWith('java.')) return true;
    // Skip common Java types
    const standardTypes = ['Instant', 'LocalDate', 'LocalDateTime', 'ZonedDateTime', 'Duration',
                          'BigDecimal', 'BigInteger', 'UUID', 'Optional',
                          'List', 'Set', 'Map', 'Collection', 'Iterable'];
    return standardTypes.includes(typeName);
}

// Import the main entity class for @UniqueFields annotation
%>
import <%= entityPackage %>.<%= entityName %>;
<%
// Find reference types from entity fields
fields.forEach(field => {
    if (field.typeKind === 'entity' || field.isRelation || field.relationType === 'ManyToOne') {
        const entityType = field.isCollection ? field.actualType : field.type;

        // Skip standard Java types - they should not be treated as entities
        if (isStandardJavaType(entityType, field.importPath)) {
            return; // skip this field
        }

        // Always use the correct domain entity package path
        let entityImport;
        if (field.importPath && !field.importPath.includes('jakarta.persistence')) {
            entityImport = field.importPath;
        } else {
            // Default to same module path as current entity
            // Use entityBasePackage if available, otherwise extract from entityPackage
            const entityBasePkg = entityBasePackage || entityPackage.substring(0, entityPackage.lastIndexOf('.'));
            entityImport = `${entityBasePkg}.${modulePath}.${entityType}`;
        }
        if (!importedTypes.has(entityType)) {
            importedTypes.add(entityType); %>
import <%= entityImport %>;<%
        }
    }
    // Handle enum type
    else if (field.typeKind === 'enum') {
        // Use the import path from field analysis
        if (field.importPath && !importedTypes.has(field.type)) {
            importedTypes.add(field.type); %>
import <%= field.importPath %>;<%
        }
    }
    // Handle a value type kept in the row (a record or an embeddable in a JSON column, say)
    else if (field.typeKind === 'value') {
        const valueType = field.isCollection ? field.actualType : field.type;
        if (field.importPath && !importedTypes.has(valueType)) {
            importedTypes.add(valueType); %>
import <%= field.importPath %>;<%
        }
    }
}); %>
