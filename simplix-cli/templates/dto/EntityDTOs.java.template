    @Data
    public static class <%= classPrefix %>DetailDTO {
        <%
        const detailFields = getMergedFieldsForView('detail');
        // Track already processed field names to avoid duplicates
        const processedDetailFieldNames = new Set();

        for (let mergedField of detailFields) {
            const field = mergedField;
            const ymlField = mergedField.ymlField;

            let fieldType = formatDtoFieldType(field, ymlField);
            let fieldName = field.name;
            let comment = ymlField?.comment || (field.comment ? field.comment.split(':')[0] : fieldNameToComment(field.name));

            // For reference fields, check if we need JsonIncludeProperties for Hibernate proxy
            // Ensure we don't treat standard Java types or String FK fields as reference fields
            // String FK fields (e.g., contentId) should not have @JsonIncludeProperties
            const isYmlReferenceField = ymlField?.reference && !ymlField.reference.multiple &&
                                     !isStandardJavaType(fieldType, field.importPath) &&
                                     fieldType !== 'String' && !fieldNameEndsWithId(fieldName);

            // Check if Entity field has @JsonIncludeProperties annotation (ManyToOne objects)
            const hasEntityJsonIncludeProps = field.jsonIncludeProperties && field.jsonIncludeProperties.length > 0;
            const isManyToOneObject = field.relationType === 'ManyToOne' && field.typeKind === 'entity' &&
                                      !isStandardJavaType(fieldType, field.importPath);

            // Determine @JsonIncludeProperties value
            let jsonIncludePropsValue = null;
            if (hasEntityJsonIncludeProps) {
                // Use Entity's @JsonIncludeProperties value
                jsonIncludePropsValue = field.jsonIncludeProperties.map(p => `"${p}"`).join(', ');
            } else if (isYmlReferenceField) {
                // Use YML reference idField
                jsonIncludePropsValue = `"${ymlField.reference.idField}"`;
            }

            const isReferenceField = isYmlReferenceField || hasEntityJsonIncludeProps || isManyToOneObject;

            // Skip if already processed (avoid duplicates)
            if (processedDetailFieldNames.has(fieldName)) continue;
            processedDetailFieldNames.add(fieldName);

            // Skip collection handling for inherited fields
            if (!mergedField.isInherited) {
                // For collection field (skip for reference fields already handled)
                if (field.isCollection && !ymlField?.reference) {
                    if (field.collectionType === 'Map') {
                        fieldType = field.type;  // Use original type format like Map<String, String>
                    } else {
                        fieldType = `${field.collectionType || 'List'}<${field.actualType || 'String'}>`;
                    }
                }
            }

            // Check for i18n fields
            const i18nSourceField = i18nFieldMap.get(fieldName);
            const isI18nField = fieldName.endsWith('I18n');
        %>
        @Schema(description = "<%= comment %>")
<% if (isReferenceField && jsonIncludePropsValue) { %>        @JsonIncludeProperties({<%= jsonIncludePropsValue %>})
<% } %><% if (i18nSourceField) { %>        @I18nTrans(source="<%= i18nSourceField %>")
<% } %><% if (isI18nField) { %>        @JsonIgnore
<% } %>        private <%- fieldType %> <%= fieldName %>;
        <% } %>

        //----------

        @Schema(description = "Created by")
        private String createdBy;

        @Schema(description = "Created at")
        @DateTimeFormat(pattern = "yyyy-MM-dd HH:mm")
        private Instant createdAt;

        @Schema(description = "Updated by")
        private String updatedBy;

        @Schema(description = "Updated at")
        @DateTimeFormat(pattern = "yyyy-MM-dd HH:mm")
        private Instant updatedAt;
    }

