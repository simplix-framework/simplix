public class <%= classPrefix %>DTOs {
<%
// Build i18n field mapping: baseFieldName -> i18nFieldName
// Example: description -> descriptionI18n
const i18nFieldMap = new Map();
entityFields.forEach(field => {
    if (field.name.endsWith('I18n')) {
        const baseFieldName = field.name.substring(0, field.name.length - 4);
        const baseField = entityFields.find(f => f.name === baseFieldName);
        if (baseField) {
            i18nFieldMap.set(baseFieldName, field.name);
        }
    }
});

// ============== DERIVED I18N COLUMNS ==============
// A locale map can be neither pattern-matched nor ordered, so a localized field that a list
// searches or sorts by carries derived columns beside it: <x>Search folds every language into one
// normalized string, and one <x>Sort<Lang> per language holds what that language's reader sees.
// I18nDerivedColumnListener fills them on every write; here they are what the SearchDTO points at.
//
// The pairing is the listener's, so the two cannot disagree: the locale map has to be there for a
// <x>Search or <x>Sort<Lang> field to be claimed as derived. Claiming by suffix alone would sweep
// up ordinary fields - sortKey, sortOrder, searchTerm.
const derivedI18nFields = new Map();
const derivedI18nColumnNames = new Set();
i18nFieldMap.forEach((i18nFieldName, baseFieldName) => {
    // The derived columns are answered through the application's rewrite of the search parameters,
    // which the project configuration names under supportClasses.localizedSearchParams. Without it
    // they are ordinary columns and the SearchDTO points at the base column.
    if (!supportClasses.find('localizedSearchParams')) return;

    const searchFieldName = `${baseFieldName}Search`;
    const sortPrefix = `${baseFieldName}Sort`;

    const search = entityFields.some(f => f.name === searchFieldName && f.type === 'String')
        ? searchFieldName : null;
    const sorts = entityFields
        .filter(f => f.type === 'String'
            && f.name.startsWith(sortPrefix)
            && f.name.length > sortPrefix.length)
        .map(f => ({
            field: f.name,
            language: f.name.substring(sortPrefix.length).toLowerCase()
        }));

    if (!search && sorts.length === 0) return;

    derivedI18nFields.set(baseFieldName, { search, sorts });
    if (search) derivedI18nColumnNames.add(search);
    sorts.forEach(sort => derivedI18nColumnNames.add(sort.field));
});

// ============== TREE ENTITY DETECTION ==============
// Use hasTreeEntity from generator context (entity implements TreeEntity interface)
// Fallback to parentId field check if hasTreeEntity is not defined
const isTreeEntity = typeof hasTreeEntity !== 'undefined' ? hasTreeEntity :
                     (entityFields.some(f => f.name === 'parentId') ||
                      (ymlConfig.fields && ymlConfig.fields['parentId']));

// ============== INHERITED FIELD SUPPORT ==============
// Build entityFields name set for quick lookup
const entityFieldNames = new Set(entityFields.map(f => f.name));

// Build excluded fields set from generator-simplix.json configuration
const excludedFieldsSet = new Set(dtoExcludeFields || []);

// Helper: Check if a field should be excluded from DTO generation
function isExcludedField(fieldName) {
    // A derived i18n column is never a DTO field of its own. The listener recomputes it from the
    // locale map on every write, so offering it for edit would offer a value the next save throws
    // away, and showing it would put normalized search text on a screen. The SearchDTO names the
    // sort columns explicitly below; nothing else does.
    return excludedFieldsSet.has(fieldName) || derivedI18nColumnNames.has(fieldName);
}

// Helper: Check if a field is a self-reference (references the same entity)
// Note: FK ID fields (like parentId) should NOT be skipped - they need to be in DTOs for input
// Only the ManyToOne object field (like parent) should be skipped to avoid circular references
function isSelfReferenceField(fieldName, ymlField) {
    if (!ymlField?.reference?.entity) return false;
    if (ymlField.reference.entity !== entityName) return false;
    // If this field IS the FK ID field (fieldName === idField), don't skip it
    // FK ID fields like 'parentId' should be included in DTOs for tree structure input
    if (ymlField.reference.idField === fieldName) return false;
    return true;
}

// Helper: Check if entity has explicit ID field for a reference field
// e.g., if entity has both 'channel' (ManyToOne) and 'channelId' (String), skip generating ID from reference
function hasExplicitIdField(referenceFieldName) {
    const expectedIdFieldName = referenceFieldName + 'Id';
    return entityFields.some(f => f.name === expectedIdFieldName);
}

// Helper: Check if field name already ends with 'Id' (to avoid 'IdId' pattern)
function fieldNameEndsWithId(fieldName) {
    return fieldName.endsWith('Id') && fieldName !== 'Id';
}

// Helper: whether a referencing field holds the key itself (a scalar column such as grantedBy or
// userAccountId) rather than an association whose key sits one step further (channel.channelId).
// The field's own type decides; a name ending in 'Id' is a scalar key whatever the analyzer reports.
function holdsReferenceKey(fieldName) {
    if (fieldNameEndsWithId(fieldName)) return true;
    const entityField = entityFields.find(f => f.name === fieldName);
    return Boolean(entityField) && entityField.typeKind !== 'entity' && !entityField.isCollection;
}

// Helper: Get ID field name for reference field (avoids 'IdId' pattern)
function getReferenceIdFieldName(fieldName, isMultiple) {
    if (isMultiple) {
        // For multiple references: field -> fieldIds, fieldId -> fieldIds (not fieldIdIds)
        return fieldNameEndsWithId(fieldName) ? `${fieldName}s` : `${fieldName}Ids`;
    } else {
        // For single reference: field -> fieldId, fieldId -> fieldId (not fieldIdId)
        return holdsReferenceKey(fieldName) ? fieldName : `${fieldName}Id`;
    }
}

// Convert camelCase field name to human-readable comment
function fieldNameToComment(fieldName) {
    return fieldName.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase()).trim();
}

// Convert one yml searchOperators entry to its SearchOperator enum constant.
function toSearchOperator(op) {
    // yml names are camelCase; the SearchOperator constants are UPPER_SNAKE, with the
    // inclusive comparisons spelled ..._OR_EQUAL_TO.
    const aliases = {
        greaterThanOrEqual: 'GREATER_THAN_OR_EQUAL_TO', greaterThanOrEquals: 'GREATER_THAN_OR_EQUAL_TO',
        lessThanOrEqual: 'LESS_THAN_OR_EQUAL_TO', lessThanOrEquals: 'LESS_THAN_OR_EQUAL_TO',
    };
    if (aliases[op]) return aliases[op];
    return op.replace(/([a-z0-9])([A-Z])/g, '$1_$2').toUpperCase();
}

// ============== THE ENTITY ID'S SEARCH CONTRACT ==============
// The id never reaches entitySearchFields - prepareSearchFields drops it before the template sees
// anything - so its yml declaration is read here directly, and the two halves below are added
// whatever that declaration says. Both are mandatory and the scaffold used to emit neither:
//
//   sortable   the frontend's default list sort is `<entityId>.desc`, so without it the very
//              first request a scaffolded list makes is refused and the screen never loads.
//   IN         a list's filter FOR this entity resolves the labels of what is selected by asking
//              this entity's own search for those ids at once (`<entityId>.in=a,b,c`). Left out,
//              that filter refuses the whole request the moment a value is picked - on every
//              list that offers it, including other modules', since the filter is shared.
//
// The asymmetry that hides it: the same id declared as a FOREIGN key on another entity is
// routinely {EQUALS, IN} and works, so only the entity's own list carries the defect.
function idSearchOperators() {
    const declared = (ymlConfig.fields?.[ymlConfig.idField]?.searchOperators || []).map(toSearchOperator);
    const operators = ['EQUALS', 'IN'];
    declared.forEach(op => { if (!operators.includes(op)) operators.push(op); });
    return operators.join(', ');
}

// Infer type from YML field configuration or field name pattern
function inferFieldType(fieldName, ymlField) {
    // If YML has explicit type, use it
    if (ymlField?.type) {
        return ymlField.type;
    }
    // Infer from searchOperators pattern
    if (ymlField?.searchOperators) {
        const ops = ymlField.searchOperators;
        if (ops.includes('between')) {
            return 'Instant'; // Date/time fields typically use between
        }
        if (ops.includes('greaterThan') && ops.includes('lessThan') && !ops.includes('contains')) {
            // Numeric or version field
            if (fieldName === 'version') return 'Long';
            return 'Long';
        }
    }
    // Infer from maxLength (String fields)
    if (ymlField?.maxLength) {
        return 'String';
    }
    // Default to String
    return 'String';
}

// Helper: Get all fields for a view, including inherited ones from YML
function getMergedFieldsForView(viewFilter) {
    const result = [];
    const processedFieldNames = new Set();

    // 1. Add all fields from entityFields that match the view filter
    for (const field of entityFields) {
        // Skip globally excluded fields
        if (isExcludedField(field.name)) continue;

        const ymlField = ymlConfig.fields[field.name];

        // Skip self-reference fields (e.g., parent field referencing same entity)
        if (isSelfReferenceField(field.name, ymlField)) continue;

        if (ymlField && ymlField.views?.includes(viewFilter)) {
            result.push({
                ...field,
                ymlField: ymlField,
                isInherited: false
            });
            processedFieldNames.add(field.name);
        }
    }

    // 2. Add fields from ymlConfig that are not in entityFields (inherited fields)
    for (const [fieldName, ymlField] of Object.entries(ymlConfig.fields || {})) {
        // Skip globally excluded fields
        if (isExcludedField(fieldName)) continue;

        // Skip self-reference fields (e.g., parent field referencing same entity)
        if (isSelfReferenceField(fieldName, ymlField)) continue;

        if (!processedFieldNames.has(fieldName) &&
            !entityFieldNames.has(fieldName) &&
            ymlField.views?.includes(viewFilter)) {
            result.push({
                name: fieldName,
                type: inferFieldType(fieldName, ymlField),
                comment: fieldNameToComment(fieldName),
                ymlField: ymlField,
                isInherited: true,
                isCollection: false
            });
        }
    }

    return result;
}

// Helper: Format field type for DTO (handle primitives, etc.)
function formatDtoFieldType(field, ymlField) {
    let fieldType = ymlField?.type || field.type;
    if (fieldType === 'boolean') fieldType = 'Boolean';
    if (fieldType === 'int') fieldType = 'Integer';
    if (fieldType === 'long') fieldType = 'Long';
    return fieldType;
}

// Helper: Get merged search fields including inherited ones from YML
function getMergedSearchFields() {
    const result = [];
    const processedFieldNames = new Set();

    // 1. Add all fields from entitySearchFields
    if (entitySearchFields && entitySearchFields.length > 0) {
        for (const field of entitySearchFields) {
            // Skip globally excluded fields
            if (isExcludedField(field.name)) continue;

            const ymlField = ymlConfig.fields[field.name];

            // Skip self-reference fields (e.g., parent field referencing same entity)
            if (isSelfReferenceField(field.name, ymlField)) continue;

            result.push({
                ...field,
                isInherited: false
            });
            processedFieldNames.add(field.name);
        }
    }

    // 2. Add fields from ymlConfig that are not in entityFields and have searchOperators
    for (const [fieldName, ymlField] of Object.entries(ymlConfig.fields || {})) {
        // Skip globally excluded fields
        if (isExcludedField(fieldName)) continue;

        // Skip self-reference fields (e.g., parent field referencing same entity)
        if (isSelfReferenceField(fieldName, ymlField)) continue;

        if (!processedFieldNames.has(fieldName) &&
            !entityFieldNames.has(fieldName) &&
            ymlField.searchOperators && ymlField.searchOperators.length > 0) {
            result.push({
                name: fieldName,
                type: inferFieldType(fieldName, ymlField),
                comment: fieldNameToComment(fieldName),
                sortable: ymlField.sortable || false,
                searchOperators: ymlField.searchOperators,
                entityField: fieldName,
                isInherited: true
            });
        }
    }

    return result;
}
