<% if (statusCountFields.length > 0) { %>
    @Test
    @DisplayName("statusCounts - refuses a field the list does not count by")
    void statusCounts_unknownField_refused() {
        assertThatThrownBy(() -> service.statusCounts("notAListedField", Map.of()))
                .isInstanceOf(SimpliXGeneralException.class)
                .hasMessageContaining("error.search.countFieldUnknown");
        verifyNoInteractions(searchAggregator);
    }

    @Test
    @DisplayName("statusCounts - names an enum value by its constant")
    void statusCounts_listedField_namesEachValue() {
<% if (figureScope) { -%>
        service = spy(service);
        doReturn(<%- scopedValue %>).when(service).<%= figureScope %>(any());
<% } -%>
        when(searchAggregator.countByValue(eq(<%= entityName %>.class), eq(repository), any(), eq("<%= statusCountFields[0] %>")))
                .thenReturn(List.of(new ValueCount(Thread.State.NEW, 3L)));

        assertThat(service.statusCounts("<%= statusCountFields[0] %>", Map.of("field", "<%= statusCountFields[0] %>")))
                .singleElement()
                .satisfies(count -> {
                    assertThat(count.value()).isEqualTo("NEW");
                    assertThat(count.count()).isEqualTo(3L);
                });
    }
<% } %>
<% if (aggregateItems.length > 0) { %>
    @Test
    @DisplayName("aggregates - asks for every listed figure in order")
    void aggregates_asksForEveryListedFigure() {
<% if (figureScope) { -%>
        service = spy(service);
        doReturn(<%- scopedValue %>).when(service).<%= figureScope %>(any());
<% } -%>
        when(searchAggregator.aggregate(eq(<%= entityName %>.class), eq(repository), any(), anyList()))
                .thenAnswer(call -> ((List<SearchAggregator.Aggregate>) call.getArgument(3)).stream()
                        .map(a -> new AggregateValue(a.field(), a.op().wireName(), 0L)).toList());

        assertThat(service.aggregates(Map.of()))
                .extracting(figure -> figure.field() + ":" + figure.op())
                .containsExactly(<%- aggregateItems.map(a => `"${a.field}:${a.op}"`).join(', ') %>);
    }
<% } %>
