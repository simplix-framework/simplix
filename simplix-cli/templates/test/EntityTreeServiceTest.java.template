    @Test
    @DisplayName("Should throw exception when ID is changed during update")
    void testUpdateNodeWithChangedId() {
        // Given
        <% if (!hasEmbeddedId) { %>
        updateDto.set<%= idFieldName.charAt(0).toUpperCase() + idFieldName.slice(1) %>(childId); // Different ID
