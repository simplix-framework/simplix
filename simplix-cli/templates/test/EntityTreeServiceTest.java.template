        // When/Then
        assertThatThrownBy(() -> treeService.batchDeleteNodes(ids))
            .isInstanceOf(SimpliXGeneralException.class)
            .hasMessageContaining("Cannot delete node with children");

        verify(treeRepository, never()).deleteAllById(any());
    }

