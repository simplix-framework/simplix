    @Test
    @DisplayName("Should create root node successfully")
    void testCreateRootNode() {
        // Given
        <%= classPrefix %>DetailDTO detailDto = new <%= classPrefix %>DetailDTO();
        <% if (!hasEmbeddedId) { %>detailDto.set<%= idFieldName.charAt(0).toUpperCase() + idFieldName.slice(1) %>(testId);<% } %>

        when(treeRepository.saveAndFlush(any(<%= entityName %>.class))).thenReturn(entity);
        doAnswer(invocation -> null).when(modelMapper).map(any(), any(<%= entityName %>.class));
        when(modelMapper.map(any(<%= entityName %>.class), eq(<%= classPrefix %>DetailDTO.class)))
            .thenReturn(detailDto);

        // When
        <%= classPrefix %>DetailDTO result = treeService.createNode(createDto);

        // Then
        assertThat(result).isNotNull();
        <% if (!hasEmbeddedId) { %>
        assertThat(result.get<%= idFieldName.charAt(0).toUpperCase() + idFieldName.slice(1) %>()).isEqualTo(testId);
        <% } %>
        verify(treeRepository, times(1)).saveAndFlush(any(<%= entityName %>.class));
    }

    @Test
    @DisplayName("Should create child node successfully")
    void testCreateChildNode() {
        // Given
        createDto.setParentId(testId);
        <%= classPrefix %>DetailDTO detailDto = new <%= classPrefix %>DetailDTO();
        <% if (!hasEmbeddedId) { %>detailDto.set<%= idFieldName.charAt(0).toUpperCase() + idFieldName.slice(1) %>(childId);<% } %>
        detailDto.setParentId(testId);

        // Mock parent validation
        when(treeRepository.findById(testId)).thenReturn(Optional.of(entity));
        when(treeRepository.saveAndFlush(any(<%= entityName %>.class))).thenReturn(childEntity);
        doAnswer(invocation -> null).when(modelMapper).map(any(), any(<%= entityName %>.class));
        when(modelMapper.map(any(<%= entityName %>.class), eq(<%= classPrefix %>DetailDTO.class)))
            .thenReturn(detailDto);

        // When
        <%= classPrefix %>DetailDTO result = treeService.createNode(createDto);

        // Then
        assertThat(result).isNotNull();
        assertThat(result.getParentId()).isEqualTo(testId);
        verify(treeRepository, times(1)).saveAndFlush(any(<%= entityName %>.class));
    }

