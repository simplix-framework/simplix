    @Transactional
    public <%= classPrefix %>DetailDTO create(<%= classPrefix %>CreateDTO createDTO) {
        <%= entityName %> entity = new <%= entityName %>();
        modelMapper.map(createDTO, entity);
<%
// Generate auto-increment sortOrder logic if sortOrderConfig is present
if (ymlConfig && ymlConfig.sortOrderConfig && ymlConfig.sortOrderConfig.autoIncrement) {
    const field = ymlConfig.sortOrderConfig.field;
    const upperField = field.charAt(0).toUpperCase() + field.slice(1);
    const scopeFields = ymlConfig.sortOrderConfig.scopeFields || [];
