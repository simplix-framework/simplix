import dev.simplecore.searchable.core.service.aggregate.SearchAggregator;
import <%= searchFigures.fqn %>;
import <%= searchFigures.fqn %>.AggregateValueDTO;
import <%= searchFigures.fqn %>.ValueCountDTO;
<% } %>
<% if (ymlConfig.timeAxisField) { %>
<% if (figureScope && !hasFigures) { %>
import <%= searchFigures.fqn %>;
<% } %>
