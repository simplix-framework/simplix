<% } %>
    }
<% if (ymlConfig.timeAxisField) { %>
    /** The field a window over this record is measured on. */
    private static final String TIME_AXIS_FIELD = "<%= ymlConfig.timeAxisField %>";

    /**
     * Counts entries per slice of a window, under the conditions the list is currently read with.
     *
     * @param params Map of search parameters, the window keys already removed
     * @param from the first instant in the window, inclusive
     * @param to the instant the window ends at, exclusive
     * @param buckets how many slices to divide the window into
     * @return one count per bucket, oldest first
     */
    public List<Long> countBuckets(Map<String, String> params, Instant from, Instant to, int buckets) {
<% if (figureScope) { -%>
        // The strip counts the rows the list can show, so the caller's scope is forced as the list forces it.
        return <%= searchFigures.name %>.scoped(<%= figureScope %>(new LinkedHashMap<>(params == null ? Map.of() : params)))
                .map(scoped -> timeBucketCounter.count(<%= entityName %>.class, repository, bucketCondition(scoped),
                        TIME_AXIS_FIELD, from, to, buckets))
                .orElseGet(() -> Collections.nCopies(buckets, 0L));
<% } else { -%>
        return timeBucketCounter.count(<%= entityName %>.class, repository, bucketCondition(params == null ? Map.of() : params),
                TIME_AXIS_FIELD, from, to, buckets);
<% } -%>
    }

    private SearchCondition<<%= classPrefix %>SearchDTO> bucketCondition(Map<String, String> params) {
        return new SearchableParamsParser<<%= classPrefix %>SearchDTO>(<%= classPrefix %>SearchDTO.class)
<% if (localizedFields.length > 0) { %>                .convert(<%= localizedSearchParams.name %>.rewrite(params, <%= localizedFieldArgs %>));
<% } else { %>                .convert(params);
<% } -%>
    }
<% } %>
<% if (statusCountFields.length > 0) { %>
    /** The fields the list's cards count rows by. */
    private static final Set<String> STATUS_COUNT_FIELDS = Set.of(<%- statusCountFields.map(f => `"${f}"`).join(', ') %>);

    /**
     * Counts entries per value of one field, under the conditions the list is currently read with.
     *
     * @param field one of the fields the entity's generator input lists under {@code statusCounts}
     * @param params Map of search parameters, {@code field} among them or not
     * @return one count per value, every enum constant in declaration order
     */
    public List<ValueCountDTO> statusCounts(String field, Map<String, String> params) {
        if (!STATUS_COUNT_FIELDS.contains(field)) {
            throw new SimpliXGeneralException(ErrorCode.GEN_BAD_REQUEST, "{error.search.countFieldUnknown}", null);
        }
        Map<String, String> filters = new LinkedHashMap<>(params == null ? Map.of() : params);
        filters.remove("field");
<% if (figureScope) { -%>
        return <%= searchFigures.name %>.scoped(<%= figureScope %>(filters))
                .map(scoped -> searchAggregator.countByValue(<%= entityName %>.class, repository, figureCondition(scoped), field)
                        .stream().map(ValueCountDTO::of).toList())
                .orElseGet(List::of);
<% } else { -%>
        return searchAggregator.countByValue(<%= entityName %>.class, repository, figureCondition(filters), field)
                .stream().map(ValueCountDTO::of).toList();
<% } -%>
    }
<% } %>
<% if (aggregateItems.length > 0) { %>
    /** The figures the list's cards show, in the order they are returned. */
    private static final List<SearchAggregator.Aggregate> AGGREGATES = List.of(<% aggregateItems.forEach((a, i) => { %>
            new SearchAggregator.Aggregate("<%= a.field %>", SearchAggregator.Op.parse("<%= a.op %>"))<%= i < aggregateItems.length - 1 ? ',' : '' %><% }); %>);

    /**
     * Computes the list's figures, under the conditions the list is currently read with.
     *
     * @param params Map of search parameters
     * @return one value per figure the entity's generator input lists under {@code aggregates}
     */
    public List<AggregateValueDTO> aggregates(Map<String, String> params) {
<% if (figureScope) { -%>
        return <%= searchFigures.name %>.scoped(<%= figureScope %>(params == null ? Map.of() : params))
                .map(scoped -> searchAggregator.aggregate(<%= entityName %>.class, repository,
                                figureCondition(scoped), AGGREGATES)
                        .stream().map(AggregateValueDTO::of).toList())
                .orElseGet(() -> AGGREGATES.stream().map(AggregateValueDTO::empty).toList());
<% } else { -%>
        return searchAggregator.aggregate(<%= entityName %>.class, repository,
                        figureCondition(params == null ? Map.of() : params), AGGREGATES)
                .stream().map(AggregateValueDTO::of).toList();
<% } -%>
    }
<% } %>
<% if (hasFigures) { %>
    private SearchCondition<<%= classPrefix %>SearchDTO> figureCondition(Map<String, String> params) {
        return new SearchableParamsParser<<%= classPrefix %>SearchDTO>(<%= classPrefix %>SearchDTO.class)
