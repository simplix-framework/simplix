        }
<%  } else {
        // Scoped - check if scope field is provided
        const firstScopeField = scopeFields[0];
        const upperFirstScopeField = firstScopeField.charAt(0).toUpperCase() + firstScopeField.slice(1);
        const methodSuffix = scopeFields.map(f => f.charAt(0).toUpperCase() + f.slice(1)).join('And');
        const getterArgs = scopeFields.map(f => `createDTO.get${f.charAt(0).toUpperCase() + f.slice(1)}()`).join(', ');
%>
        // Auto-increment <%= field %> if not explicitly provided (scoped by <%= scopeFields.join(', ') %>)
        if (entity.get<%= upperField %>() == null || entity.get<%= upperField %>() == 0) {
            if (createDTO.get<%= upperFirstScopeField %>() != null) {
                <%= entityName %>Repository typedRepository = (<%= entityName %>Repository) repository;
                Integer max<%= upperField %> = typedRepository.findMax<%= upperField %>By<%= methodSuffix %>(<%= getterArgs %>);
                entity.set<%= upperField %>(max<%= upperField %> + <%= gap %>);
            }
        }
<%  }
} %>
        return saveAndGetProjection(entity<%
        Object.entries(ymlConfig.fields || {}).forEach(([fieldName, field]) => {
