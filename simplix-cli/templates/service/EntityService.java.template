     * @param searchAggregator Counts and sums the same rows, for the cards above the list<% } %>
     */
    public <%= classPrefix %>Service(
        <%= entityName %>Repository repository,
        EntityManager entityManager<%
        Array.from(addedServices).forEach(entity => { %>,
        ObjectProvider<<%= entity %>Service> <%= _.camelCase(entity + 'Service') %>Provider<%
        }); %>,
        MessageSource messageSource<% if (ymlConfig.timeAxisField) { %>,
        TimeBucketCounter timeBucketCounter<% } %><% if (hasFigures) { %>,
        SearchAggregator searchAggregator<% } %>
    ) {
        super(repository, entityManager);
        <% Array.from(addedServices).forEach(entity => { %>
        this.<%= _.camelCase(entity + 'Service') %>Provider = <%= _.camelCase(entity + 'Service') %>Provider;<%
        }); %>
        this.messageSource = messageSource;
<% if (needsTypedRepository) { %>
        this.repository = repository;
<% } %>
<% if (ymlConfig.timeAxisField) { %>
