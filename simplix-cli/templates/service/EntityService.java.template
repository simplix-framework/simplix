import java.time.Instant;
<% } %>
<%
// Parse import statements for reference entities (excluding self-reference)
// Only import services for ManyToMany references (multiple: true) since ManyToOne uses FK ID directly
const importedServices = new Set();
const importedDTOs = new Set();

// Find ManyToMany reference types from yml configuration and generate imports if different package
let hasManyToManyRefs = false;
if (ymlConfig && ymlConfig.fields) {
    Object.entries(ymlConfig.fields).forEach(([fieldName, ymlField]) => {
        // Only generate service imports for ManyToMany references (multiple: true)
        if (ymlField.reference && ymlField.reference.entity && ymlField.reference.entity !== entityName && ymlField.reference.multiple) {
            hasManyToManyRefs = true;
            const refEntity = ymlField.reference.entity;
            const refModulePath = ymlField.reference.modulePath;

            if (!importedServices.has(refEntity)) {
                importedServices.add(refEntity);
                if (refModulePath && refModulePath !== modulePath) {
                    // Different package - generate import
                    const servicePackage = basePackage + '.' + refModulePath.replace(/\//g, '.') + '.service';
                    %>
import <%= servicePackage %>.<%= refEntity %>Service;<%
                } else { %>
// <%= refEntity %>Service will be available in same package<%
                }
            }
        }
    });
}
// Also check entity fields for ManyToMany relations
if (!hasManyToManyRefs && fields) {
    hasManyToManyRefs = fields.some(f => f.relationType === 'ManyToMany' || (f.isCollection && f.typeKind === 'entity'));
}
if (hasManyToManyRefs) { %>
import org.springframework.beans.factory.ObjectProvider;
<% }

// Import entity classes used in getReference() for @MapsId/@OneToOne entity reference fields
const importedEntityRefs = new Set();
if (ymlConfig && ymlConfig.fields && fields) {
    Object.entries(ymlConfig.fields).forEach(([fieldName, ymlField]) => {
        if (ymlField.reference && !ymlField.reference.multiple && ymlField.reference.entity !== entityName) {
            const entityField = fields.find(f => f.name === fieldName);
            if (entityField && entityField.typeKind === 'entity' &&
                (entityField.relationType === 'OneToOne' || entityField.relationType === 'ManyToOne')) {
                const refEntity = ymlField.reference.entity;
                if (!importedEntityRefs.has(refEntity) && entityField.importPath) {
                    importedEntityRefs.add(refEntity); %>
import <%= entityField.importPath %>;
<%              }
            }
        }
    });
} %>

<%
// ============== LOCALIZED FIELDS ==============
// Fields a list searches and sorts through the columns derived from a locale map. The pairing is
// I18nDerivedColumnListener's, and the DTO template repeats it to point the SearchDTO at those
// columns: a <x>I18n map beside a <x> base column, with at least one <x>Search or <x>Sort<Lang>
// following. The two templates cannot share this - EJS is rendered here without a filename, so
// there is no partial to include - which is why the listener, not either template, is the
// pairing's original.
//
// The rewrite is the application's: the project configuration names the class that moves a search
// over a localized field onto its derived columns under supportClasses.localizedSearchParams.
// Without it a localized field is searched and sorted as the plain column it also is.
const localizedSearchParams = supportClasses.find('localizedSearchParams');
const localizedFields = (localizedSearchParams ? entityFields : [])
    .filter(field => field.name.endsWith('I18n')
        && entityFields.some(base => base.name === field.name.slice(0, -4) && base.type === 'String'))
    .map(field => field.name.slice(0, -4))
    .filter(root => entityFields.some(derived => derived.type === 'String'
        && (derived.name === `${root}Search`
            || (derived.name.startsWith(`${root}Sort`) && derived.name.length > `${root}Sort`.length))))
    // Only a field this surface's yml declares reaches its SearchDTO; a second surface over the
    // same entity (a self-scoped portal list) that leaves the name out has nothing to rewrite.
    .filter(root => Boolean(ymlConfig.fields && ymlConfig.fields[root]));

const localizedFieldArgs = localizedFields.map(root => `"${root}"`).join(', ');
if (localizedFields.length > 0) { %>
import <%= localizedSearchParams.fqn %>;
<% } %>
