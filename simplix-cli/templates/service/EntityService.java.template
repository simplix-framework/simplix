// A list's cards: counts per enum value (statusCounts: [field, ...]) and figures over fields
// (aggregates: [{ field, op }]), both read under the list's own search parameters.
const statusCountFields = ymlConfig.statusCounts || [];
const aggregateItems = ymlConfig.aggregates || [];
const hasFigures = statusCountFields.length > 0 || aggregateItems.length > 0;
// The method a customised service forces the caller's scope with (figureScope: { method,
// mayMatchNothing }): it takes the client's parameters and returns them scoped, as a Map, or as an
// Optional that is empty when the caller reaches no row (mayMatchNothing: true). The figures are
// read under it, so a card never counts rows the list hides.
const figureScope = ymlConfig.figureScope && ymlConfig.figureScope.method;
const needsTypedRepository = ymlConfig.timeAxisField || hasFigures;
// The class of the application that holds the figure DTOs and the scope wrapper; the project
// configuration names it under supportClasses.searchFigures.
const searchFigures = hasFigures || (ymlConfig.timeAxisField && figureScope)
    ? supportClasses.require('searchFigures', hasFigures ? 'statusCounts or aggregates' : 'timeAxisField with figureScope')
    : null;
%>
