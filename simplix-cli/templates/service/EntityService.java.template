    %>) {
        <% if (Object.values(ymlConfig.fields || {}).some(f => isWrittenReference(f))) { %>
        //----------------------------------
        // Many-to-one relationships
        //----------------------------------
        <%
        Object.entries(ymlConfig.fields || {}).forEach(([fieldName, field]) => {
            // Skip self-reference fields
            // Use fieldName for parameter name to avoid duplicates when multiple fields reference same entity
            if (isWrittenReference(field) && !field.reference.multiple) {
                const serviceVar = _.camelCase(field.reference.entity);
                const upperFieldName = fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
                const isEntityRef = isEntityReferenceField(fieldName);
                if (isEntityRef) {
        %>
        // <%= field.reference.entity %> - entity reference (@OneToOne/@MapsId or @ManyToOne object)
        if (<%= fieldName %> != null) {
            entity.set<%= upperFieldName %>(entityManager.getReference(<%= field.reference.entity %>.class, <%= fieldName %>));
        }
                <%  } else { %>
        // <%= field.reference.entity %> - set FK ID field directly
        if (<%= fieldName %> != null) {
            entity.set<%= upperFieldName %>(<%= fieldName %>);
        }
                <%  }
            }
        }); %>

        //----------------------------------
        // Many-to-many relationships
        //----------------------------------
        <%
        Object.entries(ymlConfig.fields || {}).forEach(([fieldName, field]) => {
            // Skip self-reference fields
            // Use fieldName for parameter name to avoid duplicates when multiple fields reference same entity
            if (isWrittenReference(field) && field.reference.multiple) {
                const serviceVar = _.camelCase(field.reference.entity);
                const upperFieldName = fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
        %>
        // <%= field.reference.entity %> (via <%= fieldName %>)
        if (<%= fieldName %>Ids != null) {
            <%= field.reference.entity %>Service <%= serviceVar %>Service = <%= serviceVar %>ServiceProvider.getIfAvailable();
            if (<%= serviceVar %>Service != null) {
                <%
                const entityField = fields.find(f => f.name === fieldName);
                const collectionImpl = entityField?.collectionType === 'List' ? 'ArrayList' : 'HashSet';
                %>
                entity.set<%= upperFieldName %>(new <%= collectionImpl %><>(<%= serviceVar %>Service.findAllById(<%= fieldName %>Ids)));
            }
        }
                <%
            }
        }); %>
        <% } %>

        <%= entityName %> savedEntity = saveAndFlush(entity);
        // A formula, a join-derived name and the auditing fields are filled when the row is read, so
        // the row just written is read again before it is answered.
        entityManager.refresh(savedEntity);
        return findById(savedEntity.get<%= capitalizeFirstLetter(ymlConfig.idField || 'id') %>(), <%= classPrefix %>DetailDTO.class)
            .orElseThrow(() -> new SimpliXGeneralException(ErrorCode.GEN_NOT_FOUND, "Failed to retrieve saved entity", null));
    }

