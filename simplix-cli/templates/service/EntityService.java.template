public class <%= classPrefix %>Service extends SimpliXBaseService<<%= entityName %>, <%= idType %>> {
    <%
    // Helper: Check if a type is a standard Java library type that should NOT be treated as an entity
    function isStandardJavaType(typeName) {
        if (!typeName) return false;
        // Skip java.* types
        if (typeName.startsWith('java.')) return true;
        // Skip common Java types
        const standardTypes = ['Instant', 'LocalDate', 'LocalDateTime', 'ZonedDateTime', 'Duration',
                              'BigDecimal', 'BigInteger', 'UUID', 'Optional',
                              'List', 'Set', 'Map', 'Collection', 'Iterable', 'String', 'Integer', 'Long', 'Boolean'];
        return standardTypes.includes(typeName);
    }

    // Helper: Check if field name already ends with 'Id' (to avoid 'IdId' pattern)
    function fieldNameEndsWithId(fieldName) {
        return fieldName.endsWith('Id') && fieldName !== 'Id';
    }

    // Helper: Get Lombok setter suffix for entity fields
    // For primitive boolean fields with 'is' prefix, Lombok strips 'is': isOnline -> setOnline()
    // For all other fields, the setter is the capitalized field name: name -> setName()
    function getEntitySetterSuffix(field) {
        if (field.type === 'boolean' && field.name.startsWith('is') && field.name.length > 2) {
            return field.name.charAt(2).toUpperCase() + field.name.slice(3);
        }
        return field.name.charAt(0).toUpperCase() + field.name.slice(1);
    }

    // Helper: Check if a reference field is an entity object (OneToOne/ManyToOne) vs a String FK ID field
    function isEntityReferenceField(fieldName) {
        const entityField = fields.find(f => f.name === fieldName);
        return entityField && entityField.typeKind === 'entity' &&
               (entityField.relationType === 'OneToOne' || entityField.relationType === 'ManyToOne');
    }

    // Helper: whether a reference is written through the create and update DTOs. Those DTOs carry
    // the fields whose views include 'edit'; a reference shown only on the list or the detail is
    // read-only, so nothing hands it to saveAndGetProjection and its DTO has no getter to read it from.
    function isWrittenReference(field) {
        return Boolean(field.reference && field.reference.entity !== entityName && field.views?.includes('edit'));
    }

    // Helper: whether a referencing field holds the key itself (a scalar column such as grantedBy)
    // rather than an association whose key sits one step further; the field's own type decides.
    function holdsReferenceKey(fieldName) {
        if (fieldNameEndsWithId(fieldName)) return true;
        const entityField = fields.find(f => f.name === fieldName);
        return Boolean(entityField) && entityField.typeKind !== 'entity' && !entityField.isCollection;
    }

    // Helper: Get DTO field name for reference field (avoids 'IdId' pattern)
    function getDtoFieldName(fieldName, isCollection) {
        if (isCollection) {
            return fieldNameEndsWithId(fieldName) ? `${fieldName}s` : `${fieldName}Ids`;
        } else {
            return holdsReferenceKey(fieldName) ? fieldName : `${fieldName}Id`;
        }
    }

    // Reference service member variables (only for ManyToMany - ManyToOne uses FK ID directly)
    const addedServices = new Set();
    fields.forEach(field => {
        const ymlField = ymlConfig.fields?.[field.name];
        // Only add service providers for ManyToMany relationships (collection references)
        if (field.relationType === 'ManyToMany' || (field.isCollection && field.typeKind === 'entity')) {
            const entityType = field.actualType || field.type;
            // Skip self-reference fields and standard Java types
            if (!addedServices.has(entityType) && entityType !== entityName && !isStandardJavaType(entityType)) {
                addedServices.add(entityType); %>
    private final ObjectProvider<<%= entityType %>Service> <%= _.camelCase(entityType + 'Service') %>Provider;
    <% }
        }
    });

    // Find additional ManyToMany reference types from yml configuration (excluding self-reference)
    if (ymlConfig && ymlConfig.fields) {
        Object.values(ymlConfig.fields).forEach(field => {
            // Only generate for ManyToMany references (multiple: true)
            if (field.reference && field.reference.entity && field.reference.multiple && !addedServices.has(field.reference.entity) && field.reference.entity !== entityName) {
                addedServices.add(field.reference.entity); %>
    private final ObjectProvider<<%= field.reference.entity %>Service> <%= _.camelCase(field.reference.entity + 'Service') %>Provider;
    <% }
        });
    } %>
