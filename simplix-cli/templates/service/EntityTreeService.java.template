package <%= packagePaths['service'] %>;

import <%= packagePaths['dto'] %>.<%= classPrefix %>DTOs.*;
import <%= entityPackage %>.<%= entityName %>;
<% if (hasEmbeddedId) { %>
import <%= entityPackage %>.<%= entityName %>.<%= embeddedIdType %>;
<% } %>
<%
// Parse import statements for reference entities (excluding self-reference)
// Only import entity classes for immutable reference field validation in updateNode
const importedEntities = new Set();

if (ymlConfig && ymlConfig.fields) {
    Object.entries(ymlConfig.fields).forEach(([fieldName, ymlField]) => {
        if (ymlField.reference && ymlField.reference.entity && ymlField.reference.entity !== entityName) {
            const refEntity = ymlField.reference.entity;
            const refModulePath = ymlField.reference.modulePath;

            // Import entity class for immutable reference fields (used in updateNode validation)
            if (ymlField.immutable && !importedEntities.has(refEntity)) {
                importedEntities.add(refEntity);
                if (refModulePath) {
                    const entityPackagePath = basePackage.replace('.api', '') + '.domain.entity.' + refModulePath.replace(/\//g, '.');
                    %>
import <%= entityPackagePath %>.<%= refEntity %>;<%
                }
            }
        }
    });
} %>

import dev.simplecore.simplix.core.exception.ErrorCode;
import dev.simplecore.simplix.core.exception.SimpliXGeneralException;
import dev.simplecore.simplix.core.tree.repository.SimpliXTreeRepository;
import dev.simplecore.simplix.core.tree.service.SimpliXTreeBaseService;
import org.modelmapper.ModelMapper;
import org.springframework.context.MessageSource;
import org.springframework.context.i18n.LocaleContextHolder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.*;
import java.util.stream.Collectors;

/**
 * Tree service class for managing <%= entityName %> entities.
 * <p>
 * Provides tree-specific CRUD operations, including parent-child relationship management,
 * tree traversal, and sibling reordering for <%= entityName %> entities.
 * <p>
 * This service extends SimpliXTreeBaseService which provides:
 * <ul>
 *   <li>Tree structure retrieval (findRoots, findDirectChildren, getAllDescendants)</li>
 *   <li>Tree traversal (findAncestors, getPath)</li>
 *   <li>Tree manipulation (move, copy)</li>
 * </ul>
<% if (hasEmbeddedId) { %>
 * This entity uses a composite key (<%= embeddedIdType %>).
<% } %>
 *
 * @see SimpliXTreeBaseService
 * @see <%= classPrefix %>Service
 */
@Service
@Transactional(readOnly = true)
public class <%= classPrefix %>TreeService extends SimpliXTreeBaseService<<%= entityName %>, <%= idType %>> {

    protected final ModelMapper modelMapper;
    private final MessageSource messageSource;

    /**
     * Constructs a new <%= classPrefix %>TreeService with required dependencies.
     *
     * @param treeRepository The tree repository for <%= entityName %> entities
     * @param modelMapper ModelMapper for DTO-Entity mapping
     * @param messageSource Message source for i18n error messages
     */
    public <%= classPrefix %>TreeService(
        SimpliXTreeRepository<<%= entityName %>, <%= idType %>> treeRepository,
        ModelMapper modelMapper,
        MessageSource messageSource
    ) {
        super(treeRepository);
        this.modelMapper = modelMapper;
        this.messageSource = messageSource;
    }

    //----------------------------------
    // CRUD Operations for Tree Nodes
    //----------------------------------

    /**
     * Creates a new <%= entityName %> tree node from the provided DTO.
     * <p>
     * Handles empty parentId conversion to null for root nodes.
     * FK ID fields are mapped directly by ModelMapper from DTO to entity.
     *
     * @param createDTO DTO containing the data for the new <%= entityName %>
     * @return <%= classPrefix %>DetailDTO of the created entity
     */
    @Transactional
    public <%= classPrefix %>DetailDTO createNode(<%= classPrefix %>CreateDTO createDTO) {
        <%= entityName %> entity = new <%= entityName %>();
        modelMapper.map(createDTO, entity);

        // Handle empty parentId - convert to null for root nodes
        entity.setParentId(normalizeParentId(entity.getParentId()));

        <%= entityName %> savedEntity = create(entity);
        return modelMapper.map(savedEntity, <%= classPrefix %>DetailDTO.class);
    }

    /**
     * Updates an existing <%= entityName %> tree node with the provided DTO data.
     * <p>
     * Handles empty parentId conversion to null for root nodes.
     * Validates tree structure integrity (circular reference prevention, parent existence).
     *
     * @param entity The existing <%= entityName %> entity to update
     * @param updateDto DTO containing the updated data
     * @return <%= classPrefix %>DetailDTO of the updated entity
     * @throws SimpliXGeneralException if ID is changed, circular reference detected, or related entities are not found
     */
    @Transactional
    public <%= classPrefix %>DetailDTO updateNode(<%= entityName %> entity, <%= classPrefix %>UpdateDTO updateDto) {
        if (!Objects.equals(entity.get<%= capitalizeFirstLetter(ymlConfig.idField) %>(), updateDto.get<%= capitalizeFirstLetter(ymlConfig.idField) %>())) {
            throw new SimpliXGeneralException(ErrorCode.GEN_CONFLICT, "{error.id.cannot.change}", null);
        }
<%
        // Generate immutable reference field validation (BEFORE modelMapper.map)
        Object.entries(ymlConfig.fields || {}).forEach(([fieldName, field]) => {
            if (field.reference && !field.reference.multiple && field.reference.entity !== entityName && field.immutable) {
                const upperFieldName = fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
                const idFieldName = field.reference.idField;
                const upperIdFieldName = idFieldName.charAt(0).toUpperCase() + idFieldName.slice(1);
%>

        // Validate <%= fieldName %> cannot be changed after creation (immutable)
        <%= field.reference.entity %> existing<%= upperFieldName %> = entity.get<%= upperFieldName %>();
        <%= field.reference.idType || 'String' %> existing<%= upperFieldName %>Id = existing<%= upperFieldName %> != null ? existing<%= upperFieldName %>.get<%= upperIdFieldName %>() : null;
        if (!Objects.equals(existing<%= upperFieldName %>Id, updateDto.get<%= upperIdFieldName %>())) {
            throw new SimpliXGeneralException(ErrorCode.GEN_CONFLICT, "{error.<%= _.snakeCase(fieldName) %>.cannot.change}", null);
        }
<%
            }
        });
%>

        // Preserve existing parentId for comparison
        <%= idType %> existingParentId = entity.getParentId();

        // Normalize new parentId
        final <%= idType %> newParentId = normalizeParentId(updateDto.getParentId());

        // Validate parentId change with tree structure validation
        if (!Objects.equals(existingParentId, newParentId)) {
            if (newParentId != null) {
                // Validate new parent exists
                findById(newParentId).orElseThrow(() -> {
                    String message = messageSource.getMessage("error.entity.not.found",
                        new Object[]{"Parent", newParentId},
                        "Parent not found", LocaleContextHolder.getLocale());
                    return new SimpliXGeneralException(ErrorCode.GEN_NOT_FOUND, message, null);
                });

                // Check for circular reference using base service utility method
                validateNoCircularReference(entity.get<%= capitalizeFirstLetter(ymlConfig.idField) %>(), newParentId,
                    () -> new SimpliXGeneralException(ErrorCode.VAL_VALIDATION_FAILED, "{error.tree.circular.reference}", null));
            }
        }

        modelMapper.map(updateDto, entity);
<%
        // Generate immutable reference field restoration (AFTER modelMapper.map)
        Object.entries(ymlConfig.fields || {}).forEach(([fieldName, field]) => {
            if (field.reference && !field.reference.multiple && field.reference.entity !== entityName && field.immutable) {
                const upperFieldName = fieldName.charAt(0).toUpperCase() + fieldName.slice(1);
%>

        // Restore <%= fieldName %> (immutable after creation)
        entity.set<%= upperFieldName %>(existing<%= upperFieldName %>);
<%
            }
        });
%>

        // Set validated parentId (overwrite whatever modelMapper set)
        entity.setParentId(newParentId);

        <%= entityName %> savedEntity = update(entity);
        return modelMapper.map(savedEntity, <%= classPrefix %>DetailDTO.class);
    }

    /**
     * Deletes a <%= entityName %> tree node by its ID.
     * <p>
     * This operation will fail if the node has children. Move or delete children first.
     * Caller should verify entity exists before calling this method.
     *
     * @param <%= ymlConfig.idField %> The ID of the <%= entityName %> to delete
     * @throws SimpliXGeneralException if the node has children
     */
    @Transactional
    public void deleteNode(<%= idType %> <%= ymlConfig.idField %>) {
        // Check if node has children using base service utility method
        validateNoChildren(<%= ymlConfig.idField %>, () -> {
            String message = messageSource.getMessage("error.tree.has.children",
                null, "Cannot delete node with children. Delete or move children first.",
                LocaleContextHolder.getLocale());
            return new SimpliXGeneralException(ErrorCode.VAL_VALIDATION_FAILED, message, null);
        });

        deleteById(<%= ymlConfig.idField %>);
    }

    /**
     * Deletes multiple <%= entityName %> tree nodes by their IDs.
     * <p>
     * Validates that none of the nodes have children before deletion.
     *
     * @param <%= ymlConfig.idField %>s List of <%= entityName %> IDs to delete
     * @throws SimpliXGeneralException if any node has children
     */
    @Transactional
    public void batchDeleteNodes(List<<%= idType %>> <%= ymlConfig.idField %>s) {
        // Validate none have children using base service utility method
        for (<%= idType %> <%= ymlConfig.idField %> : <%= ymlConfig.idField %>s) {
            validateNoChildren(<%= ymlConfig.idField %>, () -> {
                String message = messageSource.getMessage("error.tree.has.children",
                    new Object[]{<%= ymlConfig.idField %>},
                    "Cannot delete node " + <%= ymlConfig.idField %> + " with children.",
                    LocaleContextHolder.getLocale());
                return new SimpliXGeneralException(ErrorCode.VAL_VALIDATION_FAILED, message, null);
            });
        }
        deleteBatch(<%= ymlConfig.idField %>s);
    }

    //----------------------------------
    // Tree-Specific Operations
    //----------------------------------

    /**
     * Retrieves the tree structure starting from root nodes.
     *
     * @param fullTree If true, returns full tree with all descendants; if false, returns only root nodes
     * @return List of <%= classPrefix %>ListDTO representing the tree structure
     */
    public List<<%= classPrefix %>ListDTO> findTree(boolean fullTree) {
        return findTree(null, fullTree);
    }

    /**
     * Retrieves the tree structure starting from a specific node.
     *
     * @param parentId The root node ID to start from (null for top-level roots)
     * @param fullTree If true, returns full subtree with all descendants; if false, returns only immediate children
     * @return List of <%= classPrefix %>ListDTO representing the tree structure
     */
    public List<<%= classPrefix %>ListDTO> findTree(<%= idType %> parentId, boolean fullTree) {
        // Handle empty parentId using base service utility method
        parentId = normalizeParentId(parentId);

        List<<%= entityName %>> nodes;
        if (fullTree) {
            // Return full tree with all descendants (already structured with children)
            if (parentId == null) {
                nodes = findCompleteHierarchy();
            } else {
                nodes = getAllDescendants(parentId);
            }
            // Convert to DTOs preserving tree structure
            return mapToTreeDtoWithModelMapper(nodes);
        } else {
            // Return only immediate children (or roots) - flat list
            nodes = parentId == null ? findRoots() : findDirectChildren(parentId);
            return nodes.stream()
                .map(node -> modelMapper.map(node, <%= classPrefix %>ListDTO.class))
                .collect(Collectors.toList());
        }
    }

    /**
     * Converts entity tree to DTO tree using ModelMapper.
     * <p>
     * Uses base class utility method with ModelMapper for entity-to-DTO conversion.
     *
     * @param entities List of entities with children populated
     * @return List of DTOs with children populated
     */
    private List<<%= classPrefix %>ListDTO> mapToTreeDtoWithModelMapper(List<<%= entityName %>> entities) {
        return mapToTreeDto(
            entities,
            entity -> modelMapper.map(entity, <%= classPrefix %>ListDTO.class),
            <%= entityName %>::getChildren,
            <%= classPrefix %>ListDTO::setChildren
        );
    }
<% if (hasOrderField) {
    const orderFieldName = orderField.name;
    const upperOrderFieldName = orderFieldName.charAt(0).toUpperCase() + orderFieldName.slice(1);
    const upperIdFieldName = ymlConfig.idField.charAt(0).toUpperCase() + ymlConfig.idField.slice(1);
%>

    /**
     * Updates the order of sibling nodes under a specific parent.
     * <p>
     * This method reorders children nodes within the same parent. Use null parentId for root nodes.
     *
     * @param parentId The parent node ID (null for root level)
     * @param orderUpdateDtos List of DTOs containing the IDs and new order values
     * @return List of <%= classPrefix %>ListDTO of the reordered entities
     * @throws SimpliXGeneralException if any entity doesn't belong to the specified parent
     */
    @Transactional
    public List<<%= classPrefix %>ListDTO> updateOrders(<%= idType %> parentId, List<<%= classPrefix %>OrderUpdateDTO> orderUpdateDtos) {
        // Handle empty parentId - convert to null for root nodes
        parentId = normalizeParentId(parentId);

        List<<%= classPrefix %>ListDTO> updatedEntities = new ArrayList<>();

        for (<%= classPrefix %>OrderUpdateDTO orderUpdateDto : orderUpdateDtos) {
            if (orderUpdateDto.get<%= upperIdFieldName %>() == null) {
                continue;
            }

            Optional<<%= entityName %>> entityOpt = findById(orderUpdateDto.get<%= upperIdFieldName %>());
            if (entityOpt.isEmpty()) {
                continue; // Skip non-existent entities
            }

            <%= entityName %> entity = entityOpt.get();

            // Validate that the entity belongs to the specified parent
            if (!Objects.equals(entity.getParentId(), parentId)) {
                String message = messageSource.getMessage("error.tree.invalid.parent",
                    new Object[]{orderUpdateDto.get<%= upperIdFieldName %>(), parentId},
                    "Node " + orderUpdateDto.get<%= upperIdFieldName %>() + " does not belong to parent " + parentId,
                    LocaleContextHolder.getLocale());
                throw new SimpliXGeneralException(ErrorCode.VAL_VALIDATION_FAILED, message, null);
            }

            entity.set<%= upperOrderFieldName %>(orderUpdateDto.get<%= upperOrderFieldName %>());
            <%= entityName %> savedEntity = update(entity);

            updatedEntities.add(modelMapper.map(savedEntity, <%= classPrefix %>ListDTO.class));
        }

        return updatedEntities;
    }
<% } %>
}
